# Copy this file on the Tencent Lighthouse host only:
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# Do not add this file to Git, a Docker image, browser configuration, logs,
# screenshots, or chat messages.  The deploy script rejects placeholder values.

# Required: server-side DeepSeek credential. It is passed only to the backend
# container, never into the frontend image or browser bundle.
DEEPSEEK_API_KEY=REPLACE_WITH_YOUR_DEEPSEEK_KEY
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_TOKENS=3000

# Required: exactly 64 hexadecimal characters. Nginx injects this only for
# protected admin API calls; it is never compiled into frontend JavaScript.
ADMIN_TOKEN=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS

# Required: gateway credentials for the whole shared demo site. Give these to
# the teacher through a separate channel; do not reuse an account password.
