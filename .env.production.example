# Copy this file on the Tencent Lighthouse host only:
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# Do not add this file to Git, a Docker image, browser configuration, logs,
# screenshots, or chat messages.  The deploy script rejects placeholder values.

# Required: server-side DeepSeek credential. It is passed only to the backend
# container, never into the frontend image or browser bundle.
# New production sessions use the V6.2.1 enforced attribution contract. Sessions
# created before this switch keep the prompt and disabled/shadow/enforce mode
# recorded by their natural_opening trace; deployment changes never reinterpret
# an in-progress conversation. Older prompts remain selectable only for an
# explicit, separately reviewed rollback and affect sessions created afterwards.
NATURAL_INTERVIEWER_PROMPT_VERSION=v6.2.1
EVIDENCE_ATTRIBUTION_MODE=enforce
DEEPSEEK_API_KEY=REPLACE_WITH_YOUR_DEEPSEEK_KEY
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_MAX_TOKENS=3000
DEEPSEEK_INTERVIEW_THINKING=disabled
DEEPSEEK_INTERVIEW_MAX_TOKENS=512
DEEPSEEK_INTERVIEW_PRIMARY_TIMEOUT_SECONDS=30
DEEPSEEK_INTERVIEW_TOTAL_TIMEOUT_SECONDS=80
DEEPSEEK_SCORING_MAX_TOKENS=12000
EVIDENCE_OBSERVER_ENABLED=true
DEEPSEEK_EVIDENCE_THINKING=disabled
DEEPSEEK_EVIDENCE_MAX_TOKENS=2000
DEEPSEEK_EVIDENCE_PRIMARY_TIMEOUT_SECONDS=30
DEEPSEEK_EVIDENCE_TOTAL_TIMEOUT_SECONDS=60
NATURAL_INTERVIEW_MIN_USER_TURNS=8

# Build-time participant UI switch. Keep false for the current data-collection
# release; backend input-mode compatibility and server-side TTS remain intact.
VITE_VOICE_INPUT_ENABLED=false

# Server-side Doubao V3 TTS. Set `disabled` to keep browser speech fallback
# only. When set to `doubao`, all three provider values are required.
TTS_MODE=doubao
DOUBAO_TTS_API_KEY=REPLACE_WITH_YOUR_DOUBAO_TTS_API_KEY
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_SPEAKER=zh_female_cancan_uranus_bigtts
DOUBAO_TTS_SPEECH_RATE=-5
DOUBAO_TTS_BIT_RATE=128000
DOUBAO_TTS_CONTEXT_TEXT="请像一位成熟、温和、专注的访谈者面对面自然交谈。语气真诚克制，不要播音腔，不要教学腔，不要逐字重读；停顿自然，句尾轻收。"
DOUBAO_TTS_TIMEOUT_SECONDS=25
DOUBAO_TTS_MAX_ATTEMPTS=2

# Required only for the protected /admin review workbench and /api/v1/admin.
# The password itself is never stored here: generate an Argon2id hash with
# `make admin-password-hash`, then paste only the output below.
ADMIN_USERNAME=teacher
ADMIN_PASSWORD_HASH=REPLACE_WITH_ARGON2ID_PASSWORD_HASH
# Generate with: openssl rand -hex 32
ADMIN_JWT_SECRET=REPLACE_WITH_A_64_HEX_CHARACTER_SECRET
