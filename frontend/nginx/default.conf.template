limit_req_zone $binary_remote_addr zone=session_create:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=turn_submit:10m rate=30r/m;
limit_req_status 429;

# Tencent's Docker host uses user-namespace remapping.  Pre-created paths on
# the dedicated /tmp tmpfs avoid startup-time chown/mkdir under /var/cache.
client_body_temp_path /tmp/nginx/client;
proxy_temp_path /tmp/nginx/proxy;
fastcgi_temp_path /tmp/nginx/fastcgi;
uwsgi_temp_path /tmp/nginx/uwsgi;
scgi_temp_path /tmp/nginx/scgi;

upstream cta_v6_backend {
    server backend:8060;
    keepalive 16;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 2m;

    # The teacher-facing interview is intentionally open. Administrative
    # review remains server-only below, so public participants cannot reach
    # transcripts, exports, or human-review endpoints.

    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from fc00::/7;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(self), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; media-src 'self' blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /api/v1/health {
        return 404;
    }

    location = /api/v1/health/db {
        return 404;
    }

    location = /api/v1/sessions {
        limit_req zone=session_create burst=4 nodelay;
        proxy_pass http://cta_v6_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "";
        proxy_set_header X-Admin-Token "";
    }

    location ~ ^/api/v1/sessions/[0-9A-Fa-f-]+/turns:stream$ {
        limit_req zone=turn_submit burst=5 nodelay;
        proxy_pass http://cta_v6_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "";
        proxy_set_header X-Admin-Token "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
        add_header X-Accel-Buffering "no" always;
    }

    location ~ ^/api/v1/sessions/[0-9A-Fa-f-]+/finalize$ {
        limit_req zone=turn_submit burst=5 nodelay;
        proxy_pass http://cta_v6_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "";
        proxy_set_header X-Admin-Token "";
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }

    location ^~ /api/v1/admin {
        return 404;
    }

    location /api/v1/ {
        proxy_pass http://cta_v6_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "";
        proxy_set_header X-Admin-Token "";
    }

    location = /admin {
        return 404;
    }

    location ^~ /admin/ {
        return 404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
