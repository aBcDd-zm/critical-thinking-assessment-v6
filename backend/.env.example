APP_NAME=思衡 V6 完全自然访谈实验版
DATABASE_URL=sqlite:///./data/v6.db
AUTO_CREATE_DB=false
APP_ENV=development
MODEL_GATEWAY_MODE=real
# V6.2.1 remains the default. The reviewed V6.2.3 tone candidate may be selected
# explicitly, but both versions require the enforced evidence-attribution contract.
# Existing sessions remain bound to the prompt and attribution mode recorded by
# their opening trace, including historical shadow and disabled sessions.
NATURAL_INTERVIEWER_PROMPT_VERSION=v6.2.1
EVIDENCE_ATTRIBUTION_MODE=enforce
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_MAX_TOKENS=3000
DEEPSEEK_INTERVIEW_THINKING=disabled
DEEPSEEK_INTERVIEW_MAX_TOKENS=512
DEEPSEEK_INTERVIEW_PRIMARY_TIMEOUT_SECONDS=30
DEEPSEEK_INTERVIEW_TOTAL_TIMEOUT_SECONDS=80
DEEPSEEK_SCORING_MAX_TOKENS=12000
EVIDENCE_OBSERVER_ENABLED=true
DEEPSEEK_EVIDENCE_THINKING=disabled
DEEPSEEK_EVIDENCE_MAX_TOKENS=2000
DEEPSEEK_EVIDENCE_PRIMARY_TIMEOUT_SECONDS=8
DEEPSEEK_EVIDENCE_TOTAL_TIMEOUT_SECONDS=15
NATURAL_INTERVIEW_MIN_USER_TURNS=8
TTS_MODE=fake
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_SPEAKER=zh_female_cancan_uranus_bigtts
DOUBAO_TTS_SPEECH_RATE=-5
DOUBAO_TTS_BIT_RATE=128000
DOUBAO_TTS_CONTEXT_TEXT="请像一位成熟、温和、专注的访谈者面对面自然交谈。语气真诚克制，不要播音腔，不要教学腔，不要逐字重读；停顿自然，句尾轻收。"
DOUBAO_TTS_TIMEOUT_SECONDS=25
DOUBAO_TTS_MAX_ATTEMPTS=2
# Use `python scripts/generate_admin_password_hash.py` locally to generate an
# Argon2id value. Generate ADMIN_JWT_SECRET with at least 32 random characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=
CORS_ORIGINS=["http://127.0.0.1:5176","http://localhost:5176"]
