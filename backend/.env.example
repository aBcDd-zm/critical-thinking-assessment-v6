APP_NAME=思衡 V6 完全自然访谈实验版
DATABASE_URL=sqlite:///./data/v6.db
AUTO_CREATE_DB=false
APP_ENV=development
MODEL_GATEWAY_MODE=real
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_TOKENS=3000
DEEPSEEK_FINAL_SCORER_MAX_TOKENS=8000
DEEPSEEK_FINAL_SCORER_TIMEOUT_SECONDS=90
# Optional local override. The production Docker image already installs an
# embedded CJK font at its default path.
REPORT_PDF_FONT_PATH=
TTS_MODE=fake
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_SPEAKER=zh_female_cancan_uranus_bigtts
DOUBAO_TTS_SPEECH_RATE=-5
DOUBAO_TTS_BIT_RATE=128000
DOUBAO_TTS_CONTEXT_TEXT="请像一位成熟、温和、专注的访谈者面对面自然交谈。语气真诚克制，不要播音腔，不要教学腔，不要逐字重读；停顿自然，句尾轻收。"
DOUBAO_TTS_TIMEOUT_SECONDS=25
DOUBAO_TTS_MAX_ATTEMPTS=2
# Use `python scripts/generate_admin_password_hash.py` locally to generate an
# Argon2id value. Generate ADMIN_JWT_SECRET with at least 32 random characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=
CORS_ORIGINS=["http://127.0.0.1:5176","http://localhost:5176"]
